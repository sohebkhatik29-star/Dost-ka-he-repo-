# ============================================================
# Telegram Bulk Invite Link Checker Bot - Configuration
# ============================================================

# 1. BOT_TOKEN: Get this from @BotFather on Telegram
BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"

# 2. API_ID & API_HASH: Get these from https://my.telegram.org (under 'API development tools')
API_ID="12345678"
API_HASH="0123456789abcdef0123456789abcdef"

# 3. ADMIN_ID: Your Telegram numeric User ID (Get it from @userinfobot or @MissRose_bot)
# For multiple admins, separate with comma: "123456789,987654321"
ADMIN_ID="123456789"

# 4. (Optional) CHECK_DELAY: Delay between link checks in seconds (Default: 0.6)
CHECK_DELAY="0.6"

# 5. (Optional) MAX_LINKS_PER_BATCH: Max links allowed per check (Default: 1000)
MAX_LINKS_PER_BATCH="1000"
